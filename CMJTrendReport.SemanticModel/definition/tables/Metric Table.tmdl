	measure 'JH (cm)' =
			VAR LatestDate = MAX('rtp_latestCMJ'[Date])
			RETURN
			    CALCULATE(AVERAGE('rtp_latestCMJ'[Jump Height (Imp-Mom) (cm)]), 'rtp_latestCMJ'[Date] = LatestDate)
		formatString: 0.0
		displayFolder: Output
		lineageTag: 028473e6-2e75-4251-9596-ad48c6255fe5

	measure 'z JH (cm)' =
			-- latest test vs this athlete's own tests up to the as-of date, in SD units (negative = worse)
			VAR LatestDate = MAX('rtp_latestCMJ'[Date])
			VAR Hist = 'rtp_latestCMJ'
			VAR Cur = AVERAGEX(FILTER(Hist, 'rtp_latestCMJ'[Date] = LatestDate), 'rtp_latestCMJ'[Jump Height (Imp-Mom) (cm)])
			VAR Mu = AVERAGEX(Hist, 'rtp_latestCMJ'[Jump Height (Imp-Mom) (cm)])
			VAR Sd = STDEVX.P(Hist, 'rtp_latestCMJ'[Jump Height (Imp-Mom) (cm)])
			VAR Z = DIVIDE(Cur - Mu, Sd)
			RETURN
			    IF(ISBLANK(Cur) || COUNTROWS(Hist) < 3 || ISBLANK(Z), BLANK(), Z)
		formatString: 0.00
		isHidden
		displayFolder: Readiness z-scores
		lineageTag: cbc027a3-0940-4a32-bbfa-e2b6a1dd0b04

	measure 'colour JH (cm)' =
			VAR Z = [z JH (cm)]
			RETURN
			    SWITCH(TRUE(), ISBLANK(Z), "#FFFFFF", Z < -1, "#F07167", Z < -0.5, "#F2C14E", "#6CC28A")
		isHidden
		displayFolder: Readiness colours
		lineageTag: 04a0815f-ff48-409f-b44b-0edc73a59c44

