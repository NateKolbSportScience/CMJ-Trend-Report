	measure 'Selected Metric Z' =
			-- z-score for whichever metric a slicer has selected (used to colour the team bar charts)
			SWITCH(
			    SELECTEDVALUE('Metric Table'[Metric]),
			    "Jump Height (Imp-Mom)[cm]", [z JH (cm)],
			    "Peak Power / BM [W/kg]", [z PP/BM (W/kg)],
			    "Concentric Impulse (Asym) %", [z Conc Asym (%)],
			    "Eccentric Braking Impulse (Asym) %", [z Ecc Asym (%)],
			    "Contraction Time [ms]", [z CT (ms)],
			    "Vertical Velocity at Takeoff [m/s]", [z Takeoff Vel (m/s)],
			    "Force at Zero Velocity [N]", [z Force @ 0 Vel (N)],
			    "Countermovement Depth [cm]", [z CM Depth (cm)],
			    "CMJ Stiffness [N/m]", [z Stiffness (N/m)],
			    "Eccentric Braking RFD [N/s]", [z Ecc RFD (N/s)],
			    BLANK()
			)
		formatString: 0.00
		isHidden
		displayFolder: Readiness z-scores
		lineageTag: 3c16c83d-4017-4434-b8ae-d2a2ffca4b64

	measure 'Flagged Athletes' =
			-- athletes with at least one metric more than 1 SD worse than their normal
			COUNTROWS(
			    FILTER(
			        VALUES('athleteid'[Name]),
			        MINX({ COALESCE([z JH (cm)], 0), COALESCE([z PP/BM (W/kg)], 0), COALESCE([z Conc Asym (%)], 0), COALESCE([z Ecc Asym (%)], 0), COALESCE([z CT (ms)], 0), COALESCE([z Takeoff Vel (m/s)], 0), COALESCE([z Force @ 0 Vel (N)], 0), COALESCE([z CM Depth (cm)], 0), COALESCE([z Stiffness (N/m)], 0), COALESCE([z Ecc RFD (N/s)], 0) }, [Value]) < -1
			    )
			)
		formatString: 0
		displayFolder: Summary
		lineageTag: 15ce396b-e1d2-4913-90ce-6b6b0756f87b

	measure 'Tested This Week' =
			VAR AsOf = CALCULATE(MAX('rtp_latestCMJ'[Date]), ALL('athleteid'))
			VAR Tested =
			    COUNTROWS(FILTER(VALUES('athleteid'[Name]), CALCULATE(MAX('rtp_latestCMJ'[Date])) > AsOf - 7))
			VAR Total = COUNTROWS(VALUES('athleteid'[Name]))
			RETURN
			    FORMAT(Tested, "0") & " / " & FORMAT(Total, "0")
		displayFolder: Summary
		lineageTag: 4ea62125-376b-4fa7-8bf3-4df5739a79b7

